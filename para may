<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Para Mi Niña Linda ❤️</title>

<style>
:root {
    --rosa: #ff6b91;
    --rosa-claro: #ffe4ed;
    --rojo: #c9184a;
    --fondo: #fff7fa;
    --texto: #713449;
    --blanco: #ffffff;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Segoe UI", Arial, sans-serif;
    color: var(--texto);
    background: var(--fondo);
    overflow-x: hidden;
}

button {
    font-family: inherit;
}

.portada {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 30px 20px;
    background:
        radial-gradient(circle at top left, #ffc4d6, transparent 45%),
        linear-gradient(135deg, #fff5f8, #ffdce8);
    position: relative;
    overflow: hidden;
}

.contenido {
    max-width: 750px;
    position: relative;
    z-index: 2;
    animation: aparecer 1.5s ease;
}

.corazon-principal {
    font-size: 75px;
    animation: latido 1.5s infinite;
    margin-bottom: 20px;
}

.etiqueta {
    display: inline-block;
    background: white;
    padding: 10px 20px;
    border-radius: 30px;
    margin-bottom: 22px;
    box-shadow: 0 5px 20px #d94e7d18;
}

h1 {
    color: var(--rojo);
    font-size: clamp(2.7rem, 8vw, 5rem);
    margin-bottom: 20px;
    line-height: 1.1;
}

h2 {
    color: var(--rojo);
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    margin-bottom: 20px;
}

p {
    line-height: 1.8;
}

.texto-portada {
    font-size: 1.1rem;
    margin: 0 auto 30px;
    max-width: 580px;
}

.boton {
    display: inline-block;
    border: none;
    border-radius: 30px;
    padding: 14px 25px;
    background: var(--rosa);
    color: white;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    margin: 5px;
    box-shadow: 0 7px 20px #e76c9733;
    transition: transform .3s, background .3s;
}

.boton:hover {
    transform: translateY(-3px);
    background: var(--rojo);
}

nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 15px 10px;
    position: sticky;
    top: 0;
    z-index: 10;
    background: #ffffffed;
    backdrop-filter: blur(10px);
    box-shadow: 0 3px 15px #9d4b6810;
}

nav a {
    color: var(--texto);
    text-decoration: none;
    font-size: .9rem;
    font-weight: 600;
    padding: 9px 12px;
    border-radius: 20px;
}

nav a:hover {
    background: var(--rosa-claro);
}

.seccion {
    padding: 80px 20px;
    text-align: center;
}

.contenedor {
    max-width: 1050px;
    margin: auto;
}

.introduccion {
    max-width: 750px;
    margin: auto;
    font-size: 1.05rem;
}

.rosa {
    background: linear-gradient(135deg, #ffe4ed, #fff5f8);
}

.tarjetas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 22px;
    margin-top: 40px;
}

.tarjeta {
    background: white;
    padding: 30px 23px;
    border-radius: 22px;
    box-shadow: 0 8px 30px #b54c7110;
    transition: transform .3s;
}

.tarjeta:hover {
    transform: translateY(-7px);
}

.icono {
    font-size: 42px;
    margin-bottom: 15px;
}

.tarjeta h3 {
    color: var(--rojo);
    margin-bottom: 12px;
}

.galeria {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 22px;
    margin-top: 35px;
}

.foto {
    background: white;
    padding: 10px;
    border-radius: 18px;
    box-shadow: 0 8px 25px #8d405318;
    transition: transform .3s;
}

.foto:hover {
    transform: translateY(-5px);
}

.foto img {
    width: 100%;
    height: 290px;
    object-fit: cover;
    border-radius: 12px;
    display: block;
    cursor: pointer;
}

.foto p {
    padding: 12px 5px 5px;
    font-weight: bold;
}

.nota {
    margin-top: 22px;
    font-size: .9rem;
}

.carta {
    max-width: 760px;
    margin: 30px auto 0;
    padding: 35px;
    background: white;
    border-radius: 22px;
    box-shadow: 0 10px 35px #9c416a12;
    text-align: left;
    font-size: 1.05rem;
}

.carta p {
    margin-bottom: 18px;
}

.firma {
    color: var(--rojo);
    text-align: right;
    font-weight: bold;
    font-size: 1.1rem;
}

.caja-frase {
    max-width: 750px;
    margin: 30px auto;
    padding: 35px 25px;
    background: white;
    border-radius: 25px;
    box-shadow: 0 10px 30px #a9476a13;
}

#frase {
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--rojo);
    font-size: clamp(1.3rem, 4vw, 1.9rem);
    margin-bottom: 20px;
    transition: opacity .3s;
}

.contador {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
    margin: 35px 0;
}

.numero {
    min-width: 115px;
    padding: 22px 15px;
    background: white;
    border-radius: 18px;
    box-shadow: 0 5px 20px #a9476a12;
}

.numero strong {
    display: block;
    color: var(--rojo);
    font-size: 2.1rem;
}

.numero span {
    font-size: .9rem;
}

.sorpresa {
    max-width: 680px;
    margin: 30px auto 0;
    padding: 35px 25px;
    background: white;
    border-radius: 25px;
    box-shadow: 0 8px 30px #a9476a12;
}

#mensaje-secreto {
    display: none;
    margin-top: 25px;
    animation: aparecer .8s ease;
}

.corazon-flotante {
    position: fixed;
    bottom: -50px;
    z-index: 100;
    pointer-events: none;
    animation: subir 4s linear forwards;
}

footer {
    padding: 35px 20px;
    text-align: center;
    background: #ffdce8;
}

footer p {
    margin: 5px;
}

#visor {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    background: #210d17ed;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

#visor img {
    max-width: 95%;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 15px;
}

#cerrar-visor {
    position: absolute;
    top: 15px;
    right: 25px;
    color: white;
    font-size: 40px;
    border: none;
    background: none;
    cursor: pointer;
}

@keyframes latido {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.13); }
}

@keyframes aparecer {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes subir {
    0% { opacity: 0; transform: translateY(0) rotate(0deg); }
    15% { opacity: 1; }
    100% { opacity: 0; transform: translateY(-110vh) rotate(35deg); }
}

@media(max-width: 600px) {
    .seccion {
        padding: 60px 16px;
    }

    .carta {
        padding: 25px 20px;
    }

    nav {
        gap: 2px;
        padding: 8px 3px;
    }

    nav a {
        font-size: .78rem;
        padding: 8px;
    }

    .foto img {
        height: 270px;
    }
}

@media(prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
        scroll-behavior: auto !important;
    }
}
</style>
</head>

