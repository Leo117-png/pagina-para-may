<script>

// FECHA DE INICIO DE LA RELACIÓN: 25 DE MAYO DE 2024
// En JavaScript, enero = 0, febrero = 1, mayo = 4.
const fechaEspecial = new Date(2024, 4, 25);

function entrar() {
    document.getElementById("nosotros").scrollIntoView({
        behavior: "smooth"
    });

    soltarCorazones();
}

// FRASES ROMÁNTICAS INTERACTIVAS
const frases = [
    "Mayte, tu sonrisa es uno de mis lugares favoritos. ❤️",
    "Conocerte fue una de esas casualidades bonitas que agradezco.",
    "No necesito un día perfecto si puedo compartir un ratito contigo. 💗",
    "Me gusta tu forma de ser y todos esos pequeños detalles que te hacen única.",
    "Ojalá nunca nos falten motivos para sonreír juntos. 🌷",
    "Si los recuerdos fueran estrellas, llenaría el cielo con nuestros momentos.",
    "Mi parte favorita de muchos días es poder hablar contigo. 💌",
    "Quiero seguir conociéndote y descubrir todo lo bonito que hay en ti.",
    "Hay personas que hacen especiales los momentos. Para mí, tú eres una de ellas.",
    "Desde el 25 de mayo de 2024 guardo recuerdos que forman parte de mi historia contigo. ❤️",
    "Si pudiera regalarte algo, sería la oportunidad de verte con mis ojos y que entendieras lo especial que eres para mí.",
    "Gracias por ser parte de mi vida, Mayte. 💕",
    "Eres esa persona en la que pienso cuando recuerdo algo bonito.",
    "Ojalá tengamos muchísimas fotografías más que guardar en esta página. 📸",
    "No existe una página lo suficientemente grande para todos los recuerdos que me gustaría crear contigo."
];

let ultimaFrase = -1;

function nuevaFrase() {
    let indice;

    do {
        indice = Math.floor(Math.random() * frases.length);
    } while (indice === ultimaFrase && frases.length > 1);

    ultimaFrase = indice;

    const elemento = document.getElementById("frase");
    elemento.style.opacity = 0;

    setTimeout(() => {
        elemento.textContent = frases[indice];
        elemento.style.opacity = 1;
    }, 250);
}

// CONTADOR AUTOMÁTICO
function actualizarContador() {
    const ahora = new Date();

    if (ahora < fechaEspecial) {
        ["dias", "horas", "minutos", "segundos"].forEach(id => {
            document.getElementById(id).textContent = "0";
        });
        return;
    }

    let diferencia = Math.floor(
        (ahora.getTime() - fechaEspecial.getTime()) / 1000
    );

    const dias = Math.floor(diferencia / 86400);
    diferencia %= 86400;

    const horas = Math.floor(diferencia / 3600);
    diferencia %= 3600;

    const minutos = Math.floor(diferencia / 60);
    const segundos = diferencia % 60;

    document.getElementById("dias").textContent = dias;
    document.getElementById("horas").textContent = horas;
    document.getElementById("minutos").textContent = minutos;
    document.getElementById("segundos").textContent = segundos;
}

actualizarContador();
setInterval(actualizarContador, 1000);

// LLUVIA DE CORAZONES
function soltarCorazones() {
    const simbolos = ["❤️", "💗", "💕", "💖", "💘", "🌸"];

    for (let i = 0; i < 20; i++) {
        setTimeout(() => {
            const corazon = document.createElement("div");

            corazon.className = "corazon-flotante";
            corazon.textContent =
                simbolos[Math.floor(Math.random() * simbolos.length)];

            corazon.style.left = Math.random() * 100 + "vw";
            corazon.style.fontSize = (18 + Math.random() * 25) + "px";
            corazon.style.animationDuration = (2.5 + Math.random() * 2) + "s";

            document.body.appendChild(corazon);

            setTimeout(() => corazon.remove(), 5000);
        }, i * 100);
    }
}

// SORPRESA SECRETA
function abrirSorpresa() {
    const mensaje = document.getElementById("mensaje-secreto");

    mensaje.style.display = "block";
    soltarCorazones();

    mensaje.scrollIntoView({
        behavior: "smooth",
        block: "nearest"
    });
}

// AMPLIAR FOTOGRAFÍAS
function verFoto(imagen) {
    document.getElementById("foto-ampliada").src = imagen.src;
    document.getElementById("visor").style.display = "flex";
}

function cerrarFoto() {
    document.getElementById("visor").style.display = "none";
    document.getElementById("foto-ampliada").src = "";
}

// CERRAR FOTOGRAFÍA CON ESCAPE
document.addEventListener("keydown", function(evento) {
    if (evento.key === "Escape") {
        cerrarFoto();
    }
});

// AÑO ACTUAL
